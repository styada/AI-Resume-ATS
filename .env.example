# Environment Variables for AI Resume ATS

# OpenAI-compatible API endpoint (e.g. Ollama, LM Studio, or OpenAI)
OPENAI_API_BASE=http://localhost:11434/v1

# API key (use a real key for OpenAI, can be anything for local endpoints)
OPENAI_API_KEY=your_api_key_here

# Model to use for critique generation
OPENAI_MODEL=gpt-3.5-turbo

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173
